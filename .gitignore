# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments (never commit these) ─────────────────────────────────
venv/
.venv/
amenity_detector/      # old venv that was previously here

# ── uv ───────────────────────────────────────────────────────────────────────
# uv.lock IS committed (ensures reproducible installs across machines)
.uv/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Secrets (NEVER commit these) ─────────────────────────────────────────────
.env
*.env

# ── Tool caches ───────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Hydra outputs ─────────────────────────────────────────────────────────────
*.log
*.hydra
outputs/          # Hydra also writes here by default

# ── Model checkpoints (large files, not for git) ──────────────────────────────
model/GitForCausalLM/
model/Salesforce_blip2_flan_t5_xl/
model/LlavaModel/
model/InstructBlip/

# ── Old project files ─────────────────────────────────────────────────────────
old_project/

# ── Images and plots ──────────────────────────────────────────────────────────
plots/
storage/          # Uploaded images (runtime data, not for git)

# ── Database files (local dev SQLite fallback) ────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal

# ── Alembic ───────────────────────────────────────────────────────────────────
# The versions/ directory IS committed (migration scripts belong in git)
# But generated SQL dumps are not
*.sql.dump

# ── Project documentation (internal only, not for public GitHub) ─────────────
