# ── Environment Variables Template ────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file — it is in .gitignore.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Gemini API key — obtained from https://aistudio.google.com/
# Free tier: 1500 requests/day with Gemini 2.0 Flash.
# Required in Phase 1 if you want to use Gemini as your VLM.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Phase 2+ (not needed yet) ─────────────────────────────────────────────────

# PostgreSQL connection string for the amenity database.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Locally this points to the Docker Compose postgres service.
# DATABASE_URL=postgresql://amenity_user:amenity_pass@localhost:5432/amenity_db
