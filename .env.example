# ── Environment Variables Template ────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file — it is in .gitignore.
#   cp .env.example .env

# ── VLM provider: OpenRouter ──────────────────────────────────────────────────
# Required. Obtain a key (with credit) at https://openrouter.ai/.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Embeddings provider (OpenAI-compatible; LiteLLM proxy in production) ─────
# Used by the hybrid search pipeline to embed property descriptions and
# incoming queries. Any provider that exposes an OpenAI-style /v1/embeddings
# endpoint works (OpenAI, Azure OpenAI, a LiteLLM proxy, …).
EMBEDDINGS_BASE_URL=https://your-litellm-proxy.example.com/v1
EMBEDDINGS_API_KEY=your_embeddings_api_key_here
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://amenity_user:amenity_pass@localhost:5432/amenity_db
POSTGRES_USER=amenity_user
POSTGRES_PASSWORD=amenity_pass
POSTGRES_DB=amenity_db

# ── Image Storage ─────────────────────────────────────────────────────────────
IMAGE_STORAGE_DIR=./storage/images

# ── API Server (optional) ─────────────────────────────────────────────────────
# API_PORT=8000
