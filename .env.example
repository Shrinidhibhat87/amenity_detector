# ── Environment Variables Template ────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file — it is in .gitignore.
#   cp .env.example .env

# ── VLM provider: OpenRouter ──────────────────────────────────────────────────
# Required. Obtain a key (with credit) at https://openrouter.ai/.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Embeddings provider (OpenAI-compatible; LiteLLM proxy in production) ─────
# Used by the hybrid search pipeline to embed property descriptions and
# incoming queries. Any provider that exposes an OpenAI-style /v1/embeddings
# endpoint works (OpenAI, Azure OpenAI, a LiteLLM proxy, …).
EMBEDDINGS_BASE_URL=https://your-litellm-proxy.example.com/v1
EMBEDDINGS_API_KEY=your_embeddings_api_key_here
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://amenity_user:amenity_pass@localhost:5432/amenity_db
POSTGRES_USER=amenity_user
POSTGRES_PASSWORD=amenity_pass
POSTGRES_DB=amenity_db

# ── Locality enrichment (OpenStreetMap) ───────────────────────────────────────
# The locality agent geocodes a free-text location (Nominatim) and looks up
# nearby POIs (Overpass), both free OSM services. NOMINATIM_USER_AGENT is
# REQUIRED — Nominatim's usage policy mandates a descriptive User-Agent that
# identifies the app and includes contact info; requests without one get
# blocked. It is reused as the Overpass User-Agent too.
NOMINATIM_USER_AGENT=amenity-detector/1.0 (your.email@example.com)
# Optional — override the public endpoints (e.g. a self-hosted mirror).
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OVERPASS_BASE_URL=https://overpass-api.de/api
# Optional — model used by the locality tool-calling agent (defaults below).
# LOCALITY_AGENT_MODEL=openai/gpt-4o-mini

# ── Image Storage ─────────────────────────────────────────────────────────────
IMAGE_STORAGE_DIR=./storage/images

# ── API Server (optional) ─────────────────────────────────────────────────────
# API_PORT=8000
