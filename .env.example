# ── Environment Variables Template ────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file — it is in .gitignore.
#
#   cp .env.example .env
#
# Then edit .env with your real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── VLM: Gemini API (Phase 1+) ────────────────────────────────────────────────
# Required to use Gemini 2.0 Flash (free tier: 1500 requests/day).
# Obtain from: https://aistudio.google.com/
# Leave empty to use Ollama-only mode (no Gemini availability).
GEMINI_API_KEY=your_gemini_api_key_here

# ── VLM: Ollama (Phase 1+) ────────────────────────────────────────────────────
# URL of the Ollama server as seen FROM INSIDE the Docker container.
# On Docker Desktop (Windows / Mac / WSL2): host.docker.internal resolves to the host.
# On native Linux Docker Engine: the extra_hosts in docker-compose.yml handles this.
# Do NOT change this to http://localhost:11434 — localhost inside Docker means the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# To let Docker containers reach Ollama, the server must listen on all interfaces.
# This is a SHELL variable for Ollama itself — it does NOT go in your .env file.
# Run Ollama like this instead:
#   OLLAMA_HOST=0.0.0.0 ollama serve

# ── Database (Phase 2+) ───────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format:  postgresql://<user>:<password>@<host>:<port>/<database>
# Local Docker Compose (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://amenity_user:amenity_pass@localhost:5432/amenity_db

# PostgreSQL credentials (must match DATABASE_URL above)
# These are read by docker-compose.yml to initialise the PostgreSQL container.
POSTGRES_USER=amenity_user
POSTGRES_PASSWORD=amenity_pass
POSTGRES_DB=amenity_db

# ── Image Storage (Phase 2+) ──────────────────────────────────────────────────
# Directory where uploaded property images are saved on disk.
# In Docker Compose this maps to a named volume (see docker-compose.yml).
# Default: ./storage/images  (relative to the repo root)
IMAGE_STORAGE_DIR=./storage/images

# ── API Server (optional) ─────────────────────────────────────────────────────
# Port the FastAPI server listens on. Default: 8000.
# API_PORT=8000
