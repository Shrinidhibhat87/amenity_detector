# ── Dockerfile for the Gradio UI frontend ────────────────────────────────────
#
# This is a lightweight image — it only needs Python, Gradio, and the requests
# library to make HTTP calls to the FastAPI backend.
# The VLM and database packages are NOT imported here; they live in the API.
#
# Multi-stage build keeps the final image small:
#   Stage 1 (builder) — installs dependencies including any build tools
#   Stage 2 (runtime) — copies only the installed .venv, no build tools
#
# Usage:
#   Build:  docker build -f docker/Dockerfile.ui -t amenity-ui .
#   Run:    docker run -p 7860:7860 -e API_BASE_URL=http://api:8000 amenity-ui

# ── Stage 1: install dependencies ────────────────────────────────────────────
FROM python:3.11-slim AS builder

# Install uv — the fast Python package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency manifests first.
# Docker layer caching: if these files haven't changed, the uv sync step is
# skipped on subsequent builds — significantly faster rebuilds.
COPY pyproject.toml uv.lock ./

# Install runtime dependencies from the lockfile.
# --no-group dev  skips ruff, mypy, pytest (not needed at runtime)
# --no-group local-gpu  skips torch/transformers (not used by the UI)
RUN uv sync --frozen --no-install-project --no-group dev --no-group local-gpu

# ── Stage 2: runtime image ────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copy only the installed virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Add the venv to PATH so we can call python directly
ENV PATH="/app/.venv/bin:$PATH"

# Tell Python to look in /app for local modules (ui/ package)
ENV PYTHONPATH="/app"

# Copy only the UI source code — no API, DB, or model code needed here
COPY ui/ ./ui/

# Expose the Gradio default port
EXPOSE 7860

# Launch the Gradio app.
# API_BASE_URL should be set in docker-compose.yml: http://api:8000
CMD ["python", "-m", "ui.app"]
